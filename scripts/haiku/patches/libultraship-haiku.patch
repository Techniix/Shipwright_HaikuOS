diff --git a/src/ship/Context.cpp b/src/ship/Context.cpp
index 28a211f..7973839 100644
--- a/src/ship/Context.cpp
+++ b/src/ship/Context.cpp
@@ -29,6 +29,11 @@
 #include <pwd.h>
 #endif
 
+#ifdef __HAIKU__
+#include <image.h>
+#include <unistd.h>
+#endif
+
 namespace Ship {
 std::unique_ptr<Context> Context::mContext;
 
@@ -517,6 +522,25 @@ std::string Context::GetAppBundlePath() {
     }
 #endif
 
+#ifdef __HAIKU__
+    // Haiku has no /proc; the app image's path comes from the loader.
+    image_info info;
+    int32 cookie = 0;
+    while (get_next_image_info(B_CURRENT_TEAM, &cookie, &info) == B_OK) {
+        if (info.type != B_APP_IMAGE) {
+            continue;
+        }
+
+        std::string progpath(info.name);
+        size_t lastSlash = progpath.find_last_of('/');
+        if (lastSlash != std::string::npos) {
+            progpath.erase(lastSlash);
+            return progpath;
+        }
+        break;
+    }
+#endif
+
 #ifdef _WIN32
     std::wstring progpath(MAX_PATH, '\0');
 
@@ -578,6 +602,38 @@ std::string Context::GetAppDirectoryPath(const std::string& appName) {
     }
 #endif
 
+#if defined(__HAIKU__) && !defined(NON_PORTABLE)
+    if (const char* fpath = std::getenv("SHIP_HOME")) {
+        return std::string(fpath);
+    }
+
+    // Portable layout like the Windows and Linux zips: data lives next to the
+    // executable. Use its real path rather than "." because apps started from
+    // Tracker or Deskbar don't necessarily run with their own folder as the cwd.
+    // If the app sits in a read-only place (an hpkg in /boot/system/apps),
+    // fall back to ~/config/settings/<app>.
+    std::string exeDir = GetAppBundlePath();
+    if (access(exeDir.c_str(), W_OK) == 0) {
+        return exeDir;
+    }
+
+    std::string haikuAppName = appName;
+    if (haikuAppName.empty() && GetRawInstance() != nullptr) {
+        haikuAppName = GetRawInstance()->mShortName;
+    }
+    if (!haikuAppName.empty()) {
+        char* prefpath = SDL_GetPrefPath(NULL, haikuAppName.c_str());
+        if (prefpath != NULL) {
+            std::string ret(prefpath);
+            SDL_free(prefpath);
+            while (ret.size() > 1 && ret.back() == '/') {
+                ret.pop_back();
+            }
+            return ret;
+        }
+    }
+#endif
+
 #ifdef NON_PORTABLE
     const std::string& effectiveAppName = appName.empty() ? GetRawInstance()->mShortName : appName;
     char* prefpath = SDL_GetPrefPath(NULL, effectiveAppName.c_str());
