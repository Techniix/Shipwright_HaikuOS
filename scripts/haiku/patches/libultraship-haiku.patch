diff --git a/cmake/dependencies/haiku.cmake b/cmake/dependencies/haiku.cmake
new file mode 100644
index 0000000..3a5d2a5
--- /dev/null
+++ b/cmake/dependencies/haiku.cmake
@@ -0,0 +1,35 @@
+#=================== ImGui ===================
+# Link libGL directly. It comes from Mesa (or libglvnd's dispatcher on newer
+# Haiku); either way it exports every GL entry point. SDL2's Haiku backend
+# creates the GL context through BGLView.
+find_package(SDL2 REQUIRED)
+target_link_libraries(ImGui PUBLIC SDL2::SDL2)
+
+if (USE_OPENGLES)
+    find_library(OPENGLES_LIBRARY GLESv2)
+    target_link_libraries(ImGui PUBLIC ${OPENGLES_LIBRARY})
+    add_compile_definitions(IMGUI_IMPL_OPENGL_ES3)
+else()
+    if (NOT OPENGL_gl_LIBRARY)
+        # mesa_devel puts the libGL.so link in develop/lib; fall back to the
+        # runtime library if only mesa itself is installed.
+        find_library(OPENGL_gl_LIBRARY
+            NAMES GL libGL.so.1
+            HINTS /boot/system/develop/lib /boot/system/lib /boot/home/config/non-packaged/lib
+        )
+    endif()
+    if (NOT OPENGL_gl_LIBRARY)
+        message(FATAL_ERROR
+            "libGL not found. Install Mesa's development files:\n"
+            "    pkgman install mesa mesa_devel\n"
+            "then check that /boot/system/develop/lib/libGL.so exists and re-run cmake.")
+    endif()
+    target_link_libraries(ImGui PUBLIC ${OPENGL_gl_LIBRARY})
+
+    # ImGui's own GL loader needs EGL or GLX to find functions, and Haiku has
+    # neither. Use the prototypes libGL exports instead.
+    set_source_files_properties(${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp PROPERTIES
+        COMPILE_DEFINITIONS IMGUI_IMPL_OPENGL_LOADER_CUSTOM
+        COMPILE_OPTIONS "-include;${CMAKE_CURRENT_LIST_DIR}/haiku/imgui_gl_loader.h"
+    )
+endif()
diff --git a/cmake/dependencies/haiku/imgui_gl_loader.h b/cmake/dependencies/haiku/imgui_gl_loader.h
new file mode 100644
index 0000000..ffbd55e
--- /dev/null
+++ b/cmake/dependencies/haiku/imgui_gl_loader.h
@@ -0,0 +1,9 @@
+// Force-included into imgui_impl_opengl3.cpp on Haiku.
+//
+// ImGui's bundled loader (imgl3w) resolves GL entry points through
+// eglGetProcAddress or glXGetProcAddressARB. Haiku's Mesa has neither, so the
+// loader fails and the menus never draw. libGL.so on Haiku exports every GL
+// entry point directly, so declare the prototypes and link libGL instead.
+#pragma once
+#define GL_GLEXT_PROTOTYPES 1
+#include <SDL2/SDL_opengl.h>
diff --git a/src/fast/Fast3dGui.cpp b/src/fast/Fast3dGui.cpp
index 237a502..02d9077 100644
--- a/src/fast/Fast3dGui.cpp
+++ b/src/fast/Fast3dGui.cpp
@@ -62,6 +62,16 @@ bool Fast3dGui::SupportsViewports() {
     return false;
 #endif
 
+#ifdef __HAIKU__
+    // SDL2's Haiku backend gives every window its own BGLView context and
+    // ImGui's extra platform windows don't render reliably through it. Keep
+    // menus inside the game window unless explicitly asked for.
+    const char* haikuViewports = std::getenv("SHIP_HAIKU_VIEWPORTS");
+    if (haikuViewports == nullptr || std::string(haikuViewports) != "1") {
+        return false;
+    }
+#endif
+
     return true;
 }
 
